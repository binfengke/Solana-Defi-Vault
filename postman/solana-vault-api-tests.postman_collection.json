{
  "info": {
    "name": "Solana DeFi Vault - API Tests",
    "description": "Solana JSON-RPC API test collection for validating vault contract state, token balances, transactions, and account data on Solana blockchain.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "Get Cluster Health",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "https://api.devnet.solana.com",
              "protocol": "https",
              "host": ["api", "devnet", "solana", "com"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getHealth\"}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Cluster is healthy', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.eql('ok');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Latest Blockhash",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "https://api.devnet.solana.com",
              "protocol": "https",
              "host": ["api", "devnet", "solana", "com"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getLatestBlockhash\",\"params\":[{\"commitment\":\"finalized\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Blockhash is returned', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.have.property('value');",
                  "    pm.expect(jsonData.result.value).to.have.property('blockhash');",
                  "    pm.expect(jsonData.result.value.blockhash).to.be.a('string');",
                  "});",
                  "pm.test('Last valid block height is positive', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result.value.lastValidBlockHeight).to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get Slot",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "https://api.devnet.solana.com",
              "protocol": "https",
              "host": ["api", "devnet", "solana", "com"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"getSlot\",\"params\":[{\"commitment\":\"finalized\"}]}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Slot is a positive number', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.result).to.be.a('number').and.to.be.above(0);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
